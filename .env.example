# ========================================================
# Heirloom — Hacktoberfest 2026 Environment Configuration
# ========================================================

# Server Port
PORT=3001

# Google Gemma (Open-Weight Model)
# Option A: Local Ollama (Runs completely offline on your laptop with no internet!)
USE_OLLAMA=false
OLLAMA_HOST=http://127.0.0.1:11434
GEMMA_MODEL=gemma2:9b

# Option B: Google AI Studio / Gemma API Key
GEMMA_API_KEY=

# ElevenLabs (Voice Transcription & Grandpa Narration)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Sentry Agent Tracing (Leave empty for local developer telemetry)
SENTRY_DSN=

# MongoDB Atlas (Optional: will sync to local persistent store if empty)
MONGODB_URI=
